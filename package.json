{
  "name": "mo3ta-coverage",
  "version": "1.3.6",
  "description": "Run tests and report uncovered changed lines in a PR",
  "homepage": "https://mo3ta.top/mo3ta-coverage/",
  "main": "index.js",
  "bin": {
    "mo3ta-coverage": "./index.js",
    "mo3ta-coverage-mcp": "./mcp/server.js"
  },
  "scripts": {
    "test": "jest --coverage && node --test --test-concurrency=1 mcp/server.test.js",
    "mcp": "node mcp/server.js",
    "build": "babel index.js -o dist/index.js"
  },
  "author": "Mahmoud Mabrok",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "coverage",
    "test",
    "jest",
    "git",
    "ci",
    "code-coverage",
    "pull-request",
    "diff",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MahmoudMabrok/mo3ta-coverage.git"
  },
  "bugs": {
    "url": "https://github.com/MahmoudMabrok/mo3ta-coverage/issues"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "babel-jest": "30.5.2",
    "jest": "30.5.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
